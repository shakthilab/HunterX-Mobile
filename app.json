{
  "expo": {
    "name": "HunterX",
    "slug": "shakthi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hunterx",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0E17",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E17"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hunterx.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow HunterX to access your photos to attach screenshots to your feedback."
      }
    },
    "android": {
      "package": "com.hunterx.mobile",
      "versionCode": 1,
      "minSdkVersion": 26,
      "adaptiveIcon": {
        "backgroundColor": "#0A0E17",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E17",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HunterX to access your photos to attach screenshots to your feedback."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.991893509642-1mpn4fs7gm814s1v0cvjsd4cqfk5klh6"
        }
      ],
      "expo-web-browser",
      "@kingstinct/react-native-healthkit",
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c22f478-6a62-4a5f-99a0-d8cc4e697584"
      }
    },
    "owner": "shakthi24s-team"
  }
}
